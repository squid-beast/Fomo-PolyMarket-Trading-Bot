# ============================================================
#  Copy these to .env and fill in. NEVER commit .env.
# ============================================================

# --- MODE -----------------------------------------------------
# Start false. Only flip to true after paper results justify it.
LIVE_TRADING=false

# --- TELEGRAM (the approval channel) --------------------------
# 1. message @BotFather -> /newbot -> copy the token
# 2. message your new bot once, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  -> copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SOLANA ---------------------------------------------------
# Public RPC is rate-limited; use Helius/QuickNode/Triton for live.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# DEDICATED HOT WALLET ONLY. Generate a fresh one, fund it with just the
# trading allocation plus ~0.05 SOL for gas. Never your main wallet.
# This value stays on YOUR server. It is never transmitted anywhere else.
#   python3 -c "from solders.keypair import Keypair; import base58; \
#   k=Keypair(); print('PUBKEY', k.pubkey()); print('SECRET', base58.b58encode(bytes(k)).decode())"
SOLANA_PRIVATE_KEY=

# Optional: paid Jupiter key for better rate limits
JUPITER_API_KEY=

# --- EXECUTION GUARDS -----------------------------------------
SLIPPAGE_BPS=150              # 1.5% max slippage on a swap
MAX_PRICE_IMPACT_PCT=3.0      # abort entry above this live-quote impact
PROPOSAL_TTL_MIN=10           # ignored proposals expire; stale signals never fire

# --- CADENCE ---------------------------------------------------
SCAN_INTERVAL_SEC=300
MANAGE_INTERVAL_SEC=60
